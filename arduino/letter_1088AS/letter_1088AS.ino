const byte blankPattern[8] = {
  0, 0, 0, 0, 0, 0, 0, 0
};

void setup() {
  // 列 LOW = 关闭
  for (byte c = 0; c < 8; c++) {
    digitalWrite(colPins[c], LOW);
    pinMode(colPins[c], OUTPUT);
  }

  // 行 HIGH = 关闭
  for (byte r = 0; r < 8; r++) {
    digitalWrite(rowPins[r], HIGH);
    pinMode(rowPins[r], OUTPUT);
  }
}

// 显示一帧：依次扫描 8 行
void displayFrame(const byte pattern[8]) {
  for (byte r = 0; r < 8; r++) {
    // 设置当前行需要点亮的列
    for (byte c = 0; c < 8; c++) {
      bool isOn = (pattern[r] >> (7 - c)) & 1;
      digitalWrite(colPins[c], isOn ? HIGH : LOW);
    }

    // 打开当前行
    digitalWrite(rowPins[r], LOW);
    delayMicroseconds(1000);

    // 关闭当前行
    digitalWrite(rowPins[r], HIGH);
  }

  // 关闭全部列
  for (byte c = 0; c < 8; c++) {
    digitalWrite(colPins[c], LOW);
  }
}

// 返回字母的图案
const byte* getLetterPattern(char letter) {
  // 自动把小写转成大写
  if (letter >= 'a' && letter <= 'z') {
    letter = letter - 'a' + 'A';
  }

  if (letter >= 'A' && letter <= 'Z') {
    return alphabet[letter - 'A'];
  }

  // 空格及未支持的字符显示为空白
  return blankPattern;
}

// 在指定时间内持续刷新图案
void showPattern(const byte pattern[],
                 unsigned long durationMs) {
  unsigned long startTime = millis();

  while (millis() - startTime < durationMs) {
    displayFrame(pattern);
  }
}

void loop() {
  for (unsigned int i = 0; message[i] != '\0'; i++) {
    showPattern(getLetterPattern(message[i]),
                letterDuration);

    // 短暂熄灭，以区分连续相同的字母，例如 PP
    showPattern(blankPattern, gapDuration);
  }
}